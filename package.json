{
  "name": "rootwise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm test && npm run build && node scripts/verify-build.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test:e2e": "playwright test tests/e2e/library.spec.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "audit:mobile": "node scripts/audit.mjs",
    "test:browser": "playwright test",
    "audit:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/dm-mono": "^5.2.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "lighthouse": "^13.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
